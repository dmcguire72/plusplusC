#include <parr.h>
#include <dstr.h>
#include <cio.h>
#include <str.h>
#include <signal.h>
#include <atexit.h>
#include <atomic.h>

#include <class.pph>
#include <app.pph>
#include <ios.pph>

#define MINOR 1
#define MAJOR 0

CLASS(Demo, Application)
{
    BASE(Application)
    METHOD(bool, process_args, (void *self))
    FIELD(bool, showVersion)
    FIELD(bool, showAbout)
    FIELD(bool, showAdd)
};

CLASS_EXPORT(Demo);

static atomic_u8_t g_interrupt_count = ATOMIC_INIT(0);

static void handle_sigint(int sig)
{
    (void)sig;

    if (atomic_u8_fetch_add(&g_interrupt_count, 1) >= 1)
        _exit(130);
}

DEF_TUPLE_T(int, int, int, int_3_t);

int_3_t add_int_3(int_3_t a, int_3_t b)
{
    struct _int_3_t result;
    result.first = a.first + b.first;
    result.second = a.second + b.second;
    result.third = a.third + b.third;
    return result;
}

int program(parr_t csArgs)
{
    atomic_u8_init(&g_interrupt_count, 0);
    if (signal(SIGINT, handle_sigint) == SIG_ERR)
        return 1;

    Demo *demo = NEW(Demo);
    Application *base = AS(Application, demo);

    CALL(base, parse_args, &csArgs);
    int exit_code = CALL(base, main);

    REMOVE(demo);
    return exit_code;
}

METHOD_PROTO(Demo, void, configure_args, (void *self));
METHOD_PROTO(Demo, int, run, (void *self));
METHOD_PROTO(Demo, bool, process_args, (void *self));

CLASS_INFO(Demo, Application);

CONSTRUCTOR(Demo)
{
    SUPER_CTOR(self, Application);

    METHOD_LINK(base, Demo, configure_args);
    METHOD_LINK(base, Demo, run);
    METHOD_LINK(Demo, process_args);
}

DECONSTRUCTOR(Demo)
{
    SUPER_DTOR(self, Application);
}

IMPLEMENT(Demo, void, configure_args, (void *self))
{
    Demo *this = (Demo *)self;
    CALL(this->base.args, add_flag, "version", "Print version");
    CALL(this->base.args, add_flag, "about", "Print about info");
    CALL(this->base.args, add_flag, "add", "Add two 3D points");
}

IMPLEMENT(Demo, int, run, (void *self))
{
    Demo *this = (Demo *)self;
    Application *app = AS(Application, this);

    if (!this->process_args(self)) return 1;

    if (this->showVersion) 
    {
        CALL(cout(), fprintf, "%d.%d\n", MAJOR, MINOR);
        return 0;
    } 
    else if (this->showAbout)
    {
        CALL(cout(), fprintln, "++C Demo");
        return 0;
    }
    else if (this->showAdd)
    {
            int_3_t a = { 1, 2, 3 };
            int_3_t b = { 4, 5, 6 };
            int_3_t c = add_int_3(a, b);
            CALL(cout(), fprintf, "[1, 2, 3] + [4, 5, 6] = [%d, %d, %d]", TUPLE_EXPAND_ARGS(c));
            return 0;
    }

    CALL(cout(), fprintf, "++C Demo %d.%d\n", MAJOR, MINOR);
    CALL(app, print_help);

    return 0;
}

IMPLEMENT(Demo, bool, process_args, (void *self))
{
    Demo *this = (Demo *)self;
    this->showVersion = CALL(this->base.args, get_bool, "version");
    this->showAbout = CALL(this->base.args, get_bool, "about");
    this->showAdd = CALL(this->base.args, get_bool, "add");

    return true;
}

#include <def.h>
#include <parr.h>
#include <atexit.h>

#define WRONG_CTORS   50
#define WRONG_ATEXIT  90

static int g_ctor_n;
static int g_ctor_bad;
static int g_dtor_n;
static int g_atexit_ran;

#define CTOR(name, prio, id) \
    XXC_CONSTRUCTOR(name, prio) { if (++g_ctor_n != (id)) g_ctor_bad = 1; }

CTOR(ctor_p150,  150,  1)
CTOR(ctor_p200,  200,  2)
CTOR(ctor_p1000, 1000, 3)

XXC_CONSTRUCTOR_DEFAULT(ctor_default) { if (++g_ctor_n != 4) g_ctor_bad = 1; }

XXC_DESTRUCTOR_DEFAULT(dtor_default)
{
    if (!g_atexit_ran)
        _exit(WRONG_ATEXIT);
    if (++g_dtor_n != 1)
        _exit(100 + 1);
}

XXC_DESTRUCTOR(dtor_p1000, 1000) { if (++g_dtor_n != 2) _exit(100 + 2); }

XXC_DESTRUCTOR(dtor_p200, 200) { if (++g_dtor_n != 3) _exit(100 + 3); }

XXC_DESTRUCTOR(dtor_p150, 150)
{
    if (++g_dtor_n != 4)
        _exit(100 + 4);
    _exit(0);
}

static void on_exit_handler(void) { g_atexit_ran = 1; }

int program(parr_t csArgs)
{
    (void)csArgs;

    if (g_ctor_n != 4 || g_ctor_bad)
        return WRONG_CTORS;

    atexit(on_exit_handler);
    return 77;
}

#include <def.h>
#include <parr.h>
#include <atexit.h>

#define WRONG_CTORS   50
#define WRONG_ATEXIT  90

static int g_ctor_n;
static int g_ctor_bad;
static int g_dtor_n;
static int g_atexit_ran;

#define CTOR(name, prio, id)                                           \
    static void name(void) __attribute__((constructor(prio)));         \
    static void name(void) { if (++g_ctor_n != (id)) g_ctor_bad = 1; }

CTOR(ctor_p150,  150,  1)
CTOR(ctor_p200,  200,  2)
CTOR(ctor_p1000, 1000, 3)

static void ctor_default(void) __attribute__((constructor));
static void ctor_default(void) { if (++g_ctor_n != 4) g_ctor_bad = 1; }

static void dtor_default(void) __attribute__((destructor));
static void dtor_default(void)
{
    if (!g_atexit_ran)
        _exit(WRONG_ATEXIT);
    if (++g_dtor_n != 1)
        _exit(100 + 1);
}

static void dtor_p1000(void) __attribute__((destructor(1000)));
static void dtor_p1000(void) { if (++g_dtor_n != 2) _exit(100 + 2); }

static void dtor_p200(void) __attribute__((destructor(200)));
static void dtor_p200(void) { if (++g_dtor_n != 3) _exit(100 + 3); }

static void dtor_p150(void) __attribute__((destructor(150)));
static void dtor_p150(void)
{
    if (++g_dtor_n != 4)
        _exit(100 + 4);
    _exit(0);
}

static void on_exit_handler(void) { g_atexit_ran = 1; }

int program(parr_t csArgs)
{
    (void)csArgs;

    if (g_ctor_n != 4 || g_ctor_bad)
        return WRONG_CTORS;

    atexit(on_exit_handler);
    return 77;
}
